# Pixelforge Studio on the UbServer. The first time, the `deploy` command creates
# /opt/projects/pixelforge-assessment/shared/.env from this file, replaces every "troque-..." value with a random
# one and generates APP_KEY. That .env never goes to git.

# --- UbServer Traefik (LAN access at http://pixelforge.test) ---
APP_HOST=pixelforge.test
TRAEFIK_ENTRYPOINT=web
TRAEFIK_NETWORK=proxy

# --- Tailscale Funnel (public HTTPS at https://pixelforge.<tailnet>.ts.net) ---
# Auth key for the "pixelforge" machine (Settings > Keys: not reusable, not ephemeral, pre-approved).
# Only in the server's .env, never in git. Used only on the first login; the state then lives in a volume.
TS_AUTHKEY=

# --- Laravel ---
APP_NAME="Pixelforge Studio"
APP_ENV=production
APP_DEBUG=false
# Generated by `deploy` the first time. Keep a copy outside the server.
APP_KEY=
# The public Funnel URL (today's tailnet is taila7ffb4.ts.net).
APP_URL=https://pixelforge.taila7ffb4.ts.net
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Structured JSON-ish lines to the container log: every Pixelforge call and webhook is logged at info.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (MySQL 8.4 in the compose, no published port) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pixelforge
DB_USERNAME=pixelforge
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-tambem

# --- Sessions, queue and cache (all on the database: no Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# The app is only used over the HTTPS Funnel URL, so the cookie is Secure.
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

# --- Pixelforge (production key: separate from the local one) ---
# The key's webhook URL in the Pixelforge dashboard must be https://pixelforge.<tailnet>.ts.net/webhooks/pixelforge,
# and PIXELFORGE_WEBHOOK_SECRET is that key's whsec_... secret. Both only in the server's .env.
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=

# --- Seeded accounts (`php artisan db:seed` runs on every deploy and is idempotent) ---
# `deploy` replaces the troque-... passwords with random ones: read them in shared/.env.
ADMIN_EMAIL=admin@pixelforge.test
ADMIN_PASSWORD=troque-senha-admin
DEMO_EMAIL=demo@pixelforge.test
DEMO_PASSWORD=troque-senha-demo
