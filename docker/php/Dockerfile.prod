# Production image for Pixelforge Studio: three targets from the same code.
#   assets - builds the Vite bundle (needs PHP too: Wayfinder generates the TS routes with artisan)
#   app    - PHP-FPM, also used by queue and scheduler (same image, different command)
#   web    - nginx with the public files
# Nothing Node runs in production: only the built files are copied out of `assets`.

# ---- assets (Vite + Wayfinder) ------------------------------------------------
FROM php:8.4-cli-alpine AS assets

COPY --from=ghcr.io/mlocati/php-extension-installer:2 /usr/bin/install-php-extensions /usr/local/bin/
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
RUN install-php-extensions intl bcmath && apk add --no-cache nodejs npm

WORKDIR /build
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN cp .env.example .env \
    && composer dump-autoload --no-dev --no-scripts \
    && php artisan key:generate --no-interaction \
    && npm run build

# ---- app ----------------------------------------------------------------------
FROM php:8.4-fpm-alpine AS app

COPY --from=ghcr.io/mlocati/php-extension-installer:2 /usr/bin/install-php-extensions /usr/local/bin/
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN install-php-extensions pdo_mysql intl bcmath pcntl opcache

COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/zz-pixelforge.ini

ARG UID=1000
ARG GID=1000
RUN addgroup -g ${GID} app 2>/dev/null; adduser -D -u ${UID} -G app app 2>/dev/null; true

WORKDIR /var/www/html
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

COPY --chown=app:app . .
COPY --from=assets --chown=app:app /build/public/build public/build

RUN composer dump-autoload --no-dev --optimize --classmap-authoritative --no-scripts \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R app:app storage bootstrap/cache \
    && rm -rf /root/.composer /root/.cache

USER app
RUN php artisan package:discover --ansi

# ---- web ----------------------------------------------------------------------
FROM nginx:1.27-alpine AS web
COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public
